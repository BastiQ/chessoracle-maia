{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/*.ts": {
      "includeFiles": "{models/**,calibration/calibration.json,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.{wasm,mjs}}",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    }
  ]
}
